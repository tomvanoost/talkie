<MudThemeProvider Theme="TalkieTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" BackdropClick="true" MaxWidth="MaxWidth.Small" FullWidth="true" />
<MudSnackbarProvider />

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorizing>
                <div class="talkie-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <MudText Typo="Typo.h5" Class="pa-8">Sorry, there's nothing at this address.</MudText>
        </LayoutView>
    </NotFound>
</Router>
