@inject ApiClient Api
@inject ISnackbar Snackbar
@inject SessionState Session

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Rounded.Groups" Class="mr-2" Style="vertical-align:middle" />New group</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Group name" Variant="Variant.Outlined" MaxLength="100" AutoFocus="true" Immediate="true" Class="mb-4" />
        <div class="d-flex align-center gap-2">
            <div style="flex:1"><UserPicker @bind-Value="_email" Label="Add people by e-mail" Exclude="_emails" /></div>
            <MudIconButton Icon="@Icons.Material.Rounded.PersonAdd" Color="Color.Primary" Variant="Variant.Filled" OnClick="Add" Disabled="string.IsNullOrWhiteSpace(_email)" aria-label="Add person" />
        </div>
        <div class="d-flex flex-wrap gap-1 mt-3">
            @foreach (var email in _emails)
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" OnClose="() => _emails.Remove(email)">@email</MudChip>
            }
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">You will be the group owner and can delete any message in the group.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(_name) || _emails.Count == 0 || _busy" OnClick="CreateAsync">Create group</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string _name = "";
    private string? _email;
    private readonly List<string> _emails = [];
    private bool _busy;

    private void Add()
    {
        var email = _email?.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(email) || _emails.Contains(email) || email == Session.Me?.Email) { _email = null; return; }
        _emails.Add(email);
        _email = null;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            var conversation = await Api.PostAsync<ConversationDto>("/api/conversations/group", new CreateGroupRequest(_name, _emails.ToList()));
            MudDialog.Close(DialogResult.Ok(conversation));
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
