@* Autocomplete over all Talkie users by e-mail or name; free text e-mails are accepted too. *@
@inject ApiClient Api

<MudAutocomplete T="string" Label="@Label" Value="@Value" ValueChanged="ValueChanged" SearchFunc="SearchAsync" Variant="Variant.Outlined"
                 CoerceValue="true" DebounceInterval="250" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.AlternateEmail"
                 ResetValueOnEmptyText="true" AutoFocus="@AutoFocus" Clearable="true" MaxItems="10">
    <ItemTemplate Context="email">
        @if (_users.FirstOrDefault(u => u.Email == email) is { } user)
        {
            <div class="d-flex align-center gap-2">
                <UserAvatar Url="@user.AvatarUrl" Name="@user.DisplayName" Px="28" />
                <div>
                    <div style="font-weight:700">@user.DisplayName</div>
                    <div style="font-size:12px;color:#7F92AE">@user.Email · @user.CompanyName</div>
                </div>
            </div>
        }
        else
        {
            @email
        }
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "E-mail";
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public IReadOnlyCollection<string> Exclude { get; set; } = [];

    private List<UserSummaryDto> _users = [];

    private async Task<IEnumerable<string>> SearchAsync(string? text, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(text)) return [];
        try
        {
            _users = await Api.GetAsync<List<UserSummaryDto>>($"/api/users/search?q={Uri.EscapeDataString(text)}");
        }
        catch (ApiException)
        {
            _users = [];
        }
        return _users.Select(u => u.Email).Where(e => !Exclude.Contains(e));
    }
}
