@* Message list and composer for one conversation or channel. *@
@implements IAsyncDisposable
@inject ApiClient Api
@inject SessionState Session
@inject ChatHubClient Hub
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<div class="messages" @ref="_scroller">
    @if (_loading)
    {
        <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else if (_messages.Count == 0)
    {
        <div class="empty-chat" style="height:100%">
            <MudIcon Icon="@Icons.Material.Rounded.WavingHand" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h6">No messages yet</MudText>
            <MudText Color="Color.Secondary">Say hi and start the conversation!</MudText>
        </div>
    }
    else
    {
        @if (_hasMore)
        {
            <div class="d-flex justify-center mb-2"><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadOlderAsync">Load older messages</MudButton></div>
        }
        DateOnly? lastDay = null;
        foreach (var m in _messages)
        {
            var day = DateOnly.FromDateTime(m.CreatedAt.ToLocalTime().Date);
            if (day != lastDay)
            {
                lastDay = day;
                <div class="day-divider">@FormatDay(day)</div>
            }
            <div class="message" @key="m.Id">
                <UserAvatar Url="@m.SenderAvatarUrl" Name="@m.SenderName" Effect="@m.SenderEffect" Px="40" />
                <div class="body">
                    @if (m.ReplyTo is { } reply)
                    {
                        <div class="reply-preview"><b>@reply.SenderName</b> <span>@reply.Content</span></div>
                    }
                    <div>
                        <span class="author" style="@(m.SenderRoleColor is null ? "" : $"color:{Darken(m.SenderRoleColor)}")">@m.SenderName</span>
                        <span class="time">@m.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                    @if (m.IsDeleted)
                    {
                        <div class="text deleted">This message was deleted.</div>
                    }
                    else
                    {
                        @if (m.Content.Length > 0)
                        {
                            <div class="text">@m.Content</div>
                        }
                        @foreach (var a in m.Attachments)
                        {
                            if (a.IsImage)
                            {
                                <img class="attachment-image" src="@a.Url" alt="@a.FileName" loading="lazy" @onclick="() => PreviewAsync(a)" />
                            }
                            else
                            {
                                <a class="attachment-file" href="@a.Url" target="_blank" download="@a.FileName">
                                    <MudIcon Icon="@Icons.Material.Rounded.InsertDriveFile" Color="Color.Primary" />
                                    <span><b>@a.FileName</b><br /><small style="color:#8093AF">@FormatSize(a.Size)</small></span>
                                </a>
                            }
                        }
                        @if (m.Reactions.Count > 0)
                        {
                            <div class="reactions">
                                @foreach (var r in m.Reactions)
                                {
                                    <span class="reaction @(r.ReactedByMe ? "mine" : "")" @onclick="() => ReactAsync(m, r.Emoji)" title="@(CanReact ? "Toggle reaction" : "")">@r.Emoji <b>@r.Count</b></span>
                                }
                            </div>
                        }
                    }
                </div>
                @if (!m.IsDeleted)
                {
                    <div class="actions">
                        @if (CanSend)
                        {
                            <MudTooltip Text="Reply"><MudIconButton Icon="@Icons.Material.Rounded.Reply" Size="Size.Small" OnClick="() => StartReply(m)" aria-label="Reply" /></MudTooltip>
                        }
                        @if (CanReact)
                        {
                            <MudMenu Icon="@Icons.Material.Rounded.AddReaction" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="React">
                                <div class="d-flex pa-1">
                                    @foreach (var emoji in Emojis)
                                    {
                                        <MudMenuItem OnClick="() => ReactAsync(m, emoji)" Style="min-width:0;padding:4px 8px;font-size:20px">@emoji</MudMenuItem>
                                    }
                                </div>
                            </MudMenu>
                        }
                        @if (m.SenderId == Session.Me?.Id || CanDeleteOthers)
                        {
                            <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(m)" aria-label="Delete" /></MudTooltip>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@if (CanSend)
{
    <div class="composer">
        <div class="composer-box">
            @if (_replyTo is { } r)
            {
                <div class="composer-replying">
                    <span><MudIcon Icon="@Icons.Material.Rounded.Reply" Size="Size.Small" Style="vertical-align:middle" /> Replying to <b>@r.SenderName</b>: @Shorten(r.Content)</span>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => _replyTo = null" aria-label="Cancel reply" />
                </div>
            }
            @if (_pending.Count > 0)
            {
                <div class="pending-files">
                    @foreach (var p in _pending)
                    {
                        <div class="pending-file">
                            @if (p.IsImage && p.Preview is not null)
                            {
                                <img src="@p.Preview" alt="@p.FileName" />
                            }
                            else
                            {
                                <MudChip T="string" Icon="@Icons.Material.Rounded.AttachFile" Variant="Variant.Outlined">@p.FileName</MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Rounded.Cancel" Size="Size.Small" Style="position:absolute;top:-10px;right:-10px;background:#fff" OnClick="() => _pending.Remove(p)" aria-label="Remove attachment" />
                        </div>
                    }
                </div>
            }
            <div class="composer-row">
                <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadFilesAsync" MaximumFileCount="10">
                    <CustomContent>
                        <MudTooltip Text="Attach files">
                            <MudIconButton Icon="@Icons.Material.Rounded.AttachFile" Color="Color.Primary" OnClick="@context.OpenFilePickerAsync" aria-label="Attach files" />
                        </MudTooltip>
                    </CustomContent>
                </MudFileUpload>
                <textarea @ref="_input" rows="1" placeholder="@Placeholder" @bind="_text" @bind:event="oninput"></textarea>
                @if (_uploading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                }
                <MudIconButton Icon="@Icons.Material.Rounded.Send" Color="Color.Primary" Variant="Variant.Filled" OnClick="SendAsync" Disabled="_sending || (string.IsNullOrWhiteSpace(_text) && _pending.Count == 0)" Class="ma-1" aria-label="Send" />
            </div>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">Enter to send · Shift+Enter for a new line · paste images straight from the clipboard</MudText>
    </div>
}
else
{
    <div class="read-only-note"><MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" Style="vertical-align:middle" /> You don't have permission to send messages in this channel.</div>
}

@code {
    [Parameter] public Guid? ConversationId { get; set; }
    [Parameter] public Guid? ChannelId { get; set; }
    [Parameter] public bool CanSend { get; set; } = true;
    [Parameter] public bool CanReact { get; set; } = true;
    [Parameter] public bool CanDeleteOthers { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Write a message…";
    [Parameter] public EventCallback OnSent { get; set; }

    private static readonly string[] Emojis = ["👍", "❤️", "😂", "🎉", "😮", "😢", "🔥", "👀"];

    private sealed record PendingFile(Guid Id, string FileName, bool IsImage, string? Preview);

    private readonly List<MessageDto> _messages = [];
    private readonly List<PendingFile> _pending = [];
    private ElementReference _scroller;
    private ElementReference _input;
    private DotNetObjectReference<ChatPanel>? _self;
    private MessageDto? _replyTo;
    private string _text = "";
    private bool _loading = true;
    private bool _hasMore;
    private bool _sending;
    private bool _uploading;
    private bool _scrollPending;
    private (Guid?, Guid?) _loadedFor;

    private string BaseUrl => ConversationId is { } c ? $"/api/conversations/{c}/messages" : $"/api/channels/{ChannelId}/messages";

    protected override void OnInitialized()
    {
        Hub.MessageChanged += OnMessageChangedAsync;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == (ConversationId, ChannelId)) return;
        _loadedFor = (ConversationId, ChannelId);
        _loading = true;
        _messages.Clear();
        _pending.Clear();
        _replyTo = null;
        _text = "";
        try
        {
            var page = await Api.GetAsync<List<MessageDto>>(BaseUrl);
            _messages.AddRange(page);
            _hasMore = page.Count >= 50;
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
        _scrollPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (CanSend)
        {
            _self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("talkie.registerComposer", _input, _self);
            await JS.InvokeVoidAsync("talkie.autoGrow", _input);
        }
        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("talkie.scrollToBottom", _scroller, false);
        }
    }

    private async Task LoadOlderAsync()
    {
        var oldest = _messages.FirstOrDefault()?.CreatedAt;
        if (oldest is null) return;
        var page = await Api.GetAsync<List<MessageDto>>($"{BaseUrl}?before={Uri.EscapeDataString(oldest.Value.ToString("O"))}");
        _messages.InsertRange(0, page);
        _hasMore = page.Count >= 50;
    }

    private async Task OnMessageChangedAsync(Guid? conversationId, Guid? channelId, Guid messageId)
    {
        if (conversationId != ConversationId || channelId != ChannelId) return;
        var nearBottom = await JS.InvokeAsync<bool>("talkie.isNearBottom", _scroller);
        try
        {
            var message = await Api.GetAsync<MessageDto>($"/api/messages/{messageId}");
            Upsert(message);
        }
        catch (ApiException)
        {
            _messages.RemoveAll(m => m.Id == messageId);
        }
        _scrollPending = nearBottom;
        await InvokeAsync(StateHasChanged);
    }

    private void Upsert(MessageDto message)
    {
        var index = _messages.FindIndex(m => m.Id == message.Id);
        if (index >= 0) _messages[index] = message;
        else
        {
            _messages.Add(message);
            _messages.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
        }
    }

    [JSInvokable]
    public async Task SendFromKeyboard(string text)
    {
        _text = text;
        await SendAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPastedFile(string name, string contentType, string base64)
    {
        _uploading = true;
        StateHasChanged();
        try
        {
            var bytes = Convert.FromBase64String(base64);
            if (bytes.Length > TalkieConstants.MaxAttachmentBytes) { Snackbar.Add("Files can be at most 10 MB.", Severity.Warning); return; }
            var result = await Api.UploadBytesAsync<UploadResultDto>("/api/uploads", bytes, name, contentType);
            _pending.Add(new PendingFile(result.Id, result.FileName, result.IsImage, result.IsImage ? $"data:{contentType};base64,{base64}" : null));
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task UploadFilesAsync(IReadOnlyList<IBrowserFile>? files)
    {
        if (files is null) return;
        _uploading = true;
        foreach (var file in files)
        {
            try
            {
                if (file.Size > TalkieConstants.MaxAttachmentBytes) { Snackbar.Add($"{file.Name} is larger than 10 MB.", Severity.Warning); continue; }
                var result = await Api.UploadAsync<UploadResultDto>("/api/uploads", file, TalkieConstants.MaxAttachmentBytes);
                _pending.Add(new PendingFile(result.Id, result.FileName, result.IsImage, result.IsImage ? $"/api/attachments/{result.Id}" : null));
            }
            catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
        _uploading = false;
    }

    private async Task SendAsync()
    {
        if (_sending || _uploading || (string.IsNullOrWhiteSpace(_text) && _pending.Count == 0)) return;
        _sending = true;
        var request = new SendMessageRequest(_text, _replyTo?.Id, _pending.Select(p => p.Id).ToList());
        try
        {
            var message = await Api.PostAsync<MessageDto>(BaseUrl, request);
            Upsert(message);
            _text = "";
            _pending.Clear();
            _replyTo = null;
            await JS.InvokeVoidAsync("talkie.clear", _input);
            _scrollPending = true;
            await OnSent.InvokeAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _sending = false; }
    }

    private async Task StartReply(MessageDto message)
    {
        _replyTo = message;
        await JS.InvokeVoidAsync("talkie.focus", _input);
    }

    private async Task ReactAsync(MessageDto message, string emoji)
    {
        if (!CanReact) return;
        try { Upsert(await Api.PostAsync<MessageDto>($"/api/messages/{message.Id}/reactions", new ReactRequest(emoji))); }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteAsync(MessageDto message)
    {
        var confirm = await Dialogs.ShowMessageBoxAsync("Delete message", "Are you sure you want to delete this message?", yesText: "Delete", cancelText: "Cancel");
        if (confirm != true) return;
        try
        {
            await Api.DeleteAsync($"/api/messages/{message.Id}");
            Upsert(await Api.GetAsync<MessageDto>($"/api/messages/{message.Id}"));
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task PreviewAsync(AttachmentDto attachment)
    {
        var parameters = new DialogParameters<ImagePreviewDialog> { { d => d.Url, attachment.Url }, { d => d.Name, attachment.FileName } };
        await Dialogs.ShowAsync<ImagePreviewDialog>(attachment.FileName, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = false });
    }

    private static string FormatDay(DateOnly day)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        if (day == today) return "Today";
        if (day == today.AddDays(-1)) return "Yesterday";
        return day.ToString("dddd d MMMM yyyy");
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : bytes >= 1024 ? $"{bytes / 1024d:0} KB" : $"{bytes} B";

    private static string Shorten(string s) => s.Length > 80 ? s[..80] + "…" : s.Length == 0 ? "📎 attachment" : s;

    /// <summary>Role colors are pastel; darken them so the name stays readable.</summary>
    private static string Darken(string hex)
    {
        if (hex.Length != 7) return hex;
        var r = Convert.ToInt32(hex[1..3], 16) * 6 / 10;
        var g = Convert.ToInt32(hex[3..5], 16) * 6 / 10;
        var b = Convert.ToInt32(hex[5..7], 16) * 6 / 10;
        return $"#{r:X2}{g:X2}{b:X2}";
    }

    public ValueTask DisposeAsync()
    {
        Hub.MessageChanged -= OnMessageChangedAsync;
        _self?.Dispose();
        return ValueTask.CompletedTask;
    }
}
