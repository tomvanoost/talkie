@* A cute gift box illustration in the box's color. *@
<svg class="box-art @Class" viewBox="0 0 120 120" style="width:@(Size)px;height:@(Size)px">
    <rect x="18" y="52" width="84" height="56" rx="10" fill="@Color" />
    <rect x="18" y="52" width="84" height="56" rx="10" fill="url(#shade-@Key)" />
    <rect x="10" y="36" width="100" height="24" rx="8" fill="@Color" />
    <rect x="10" y="36" width="100" height="24" rx="8" fill="#fff" opacity=".25" />
    <rect x="52" y="36" width="16" height="72" fill="#fff" opacity=".85" />
    <path d="M60 36c-6-14-26-20-30-10s16 10 30 10z" fill="#fff" opacity=".9" />
    <path d="M60 36c6-14 26-20 30-10s-16 10-30 10z" fill="#fff" opacity=".9" />
    @if (Key == "shard")
    {
        <path d="M60 66l10 12-10 18-10-18z" fill="#5B9BEA" opacity=".85" />
    }
    else if (Key == "rare")
    {
        <path d="M60 64l4 9 10 1-8 6 3 10-9-6-9 6 3-10-8-6 10-1z" fill="#FFD54F" />
    }
    <defs>
        <linearGradient id="shade-@Key" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".0" />
            <stop offset="1" stop-color="#000" stop-opacity=".12" />
        </linearGradient>
    </defs>
</svg>

@code {
    [Parameter] public string Key { get; set; } = "common";
    [Parameter] public string Color { get; set; } = "#90CAF9";
    [Parameter] public int Size { get; set; } = 110;
    [Parameter] public string? Class { get; set; }
}
